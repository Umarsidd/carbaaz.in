{
  "name": "carbaaz-backend",
  "version": "1.0.0",
  "description": "CARBAAZ Express API and PostgreSQL operations backend",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "node --import tsx index.ts",
    "build": "tsc --noEmit",
    "postinstall": "prisma generate --schema prisma/schema.prisma || true",
    "start": "node --import tsx scripts/start.mjs",
    "seed": "node --import tsx seed.ts",
    "migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "db": "node scripts/local-db.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "embedded-postgres": "^19.0.0-beta.20",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pathe": "^1.1.2",
    "pdfkit": "^0.21.0",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5",
    "stripe": "^23.2.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "prisma": "^6.19.3",
    "smtp-server": "^3.21.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
