  "description": "CARBAAZ detailing studio, vehicle marketplace and operations ERP",
  "scripts": {
    "test": "npm run smoke",
    "predev": "npm run generate",
    "dev": "node --import tsx server/index.ts",
    "build": "npm run generate && tsc --noEmit && vite build",
    "prestart": "npm run generate",
    "start": "node --import tsx scripts/start.mjs",
    "preseed": "npm run generate",
    "seed": "node --import tsx server/seed.ts",
    "migrate": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "generate": "prisma generate --schema server/prisma/schema.prisma",
    "smoke": "node scripts/smoke.mjs"
  },
